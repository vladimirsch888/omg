# Port the server listens on
PORT=3000

# Shared secret required (as "Authorization: Bearer <token>") to write/update
# the banner text. Set this to a long random value and enter the same value
# in the amoCRM widget's install settings ("Backend admin token").
ADMIN_TOKEN=change-me-to-a-long-random-value

# Comma-separated list of origins allowed to call the API. Leave as "*" to
# allow any origin (simplest, fine for an internal/low-risk tool since reads
# are public anyway). Restrict this in production if you want to be strict,
# e.g. https://yoursubdomain.amocrm.ru,https://yoursubdomain.kommo.com
ALLOWED_ORIGINS=*

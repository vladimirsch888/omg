DATABASE_URL="postgresql://revenue:revenue@localhost:5432/revenue_saas?schema=public"
# Обязателен, минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=""
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# Часовой пояс сервера: границы месяца и "сегодня" считаются в нём
TZ="Europe/Moscow"
# % отложенный в резерв на налог с облагаемого дохода после доли вендора
TAX_RESERVE_PERCENT=7
# Саморегистрация новых организаций. По умолчанию открыта только пока в базе нет ни одной организации.
ALLOW_REGISTRATION=false
# Ежедневный дайджест напоминаний в Telegram (необязательно)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_DIGEST_HOUR=9

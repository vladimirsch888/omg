generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Organization / Users
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  currency  String   @default("RUB")
  createdAt DateTime @default(now())

  users           User[]
  clients         Client[]
  projects        Project[]
  dictionaryTypes DictionaryType[]
  operations      Operation[]
  requests        Request[]
  timeEntries     TimeEntry[]
  licenseProducts LicenseProduct[]
  subscriptions   Subscription[]
  sales           Sale[]
  salesPlans      SalesPlan[]
  auditLogs       AuditLog[]
  taxProfile      TaxProfile?
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  VIEWER
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  name           String
  role           Role         @default(MANAGER)
  isActive       Boolean      @default(true)
  /// Bumped on password change and "log out everywhere": a token whose
  /// version is older than this is rejected by requireAuth.
  tokenVersion   Int          @default(0)
  createdAt      DateTime     @default(now())

  timeEntries TimeEntry[]
  operations  Operation[] @relation("OperationCreatedBy")
  auditLogs   AuditLog[]
}

// ---------------------------------------------------------------------------
// Clients (B2B)
// ---------------------------------------------------------------------------

enum ClientStatus {
  ACTIVE
  PAUSED
  CHURNED
}

model Client {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  legalName      String?
  inn            String?
  contactPerson  String?
  contactEmail   String?
  contactPhone   String?
  status         ClientStatus @default(ACTIVE)
  notes          String?
  isDemo         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  projects      Project[]
  subscriptions Subscription[]
  sales         Sale[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Projects — client -> project -> subproject (max depth 2)
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PAUSED
  CLOSED
}

model Project {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Project?  @relation("ProjectHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Project[] @relation("ProjectHierarchy")

  name        String
  description String?
  typeValueId String?
  typeValue   DictionaryValue? @relation(fields: [typeValueId], references: [id])
  status      ProjectStatus    @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  hourlyRate  Decimal?         @db.Decimal(14, 2)
  budgetHours Decimal?         @db.Decimal(10, 2)
  isDemo      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  operations    Operation[]
  timeEntries   TimeEntry[]
  requests      Request[]
  subscriptions Subscription[]
  sales         Sale[]

  @@index([organizationId])
  @@index([clientId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Generic dictionaries (reference books) — fully user-configurable
// ---------------------------------------------------------------------------

model DictionaryType {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())

  values DictionaryValue[]

  @@unique([organizationId, code])
}

model DictionaryValue {
  id               String         @id @default(uuid())
  dictionaryTypeId String
  dictionaryType   DictionaryType @relation(fields: [dictionaryTypeId], references: [id], onDelete: Cascade)
  organizationId   String
  code             String
  name             String
  color            String?
  sortOrder        Int            @default(0)
  isActive         Boolean        @default(true)
  /// Stable machine role of a value the code has to find regardless of how
  /// the user renamed its code/name — e.g. "vendor_cost" for the category
  /// vendor payouts are booked under. Null for ordinary values.
  systemKey        String?

  operations      Operation[]      @relation("OperationCategory")
  paymentOps      Operation[]      @relation("OperationPaymentMethod")
  accountOps      Operation[]      @relation("OperationAccount")
  vendorProducts  LicenseProduct[] @relation("LicenseProductVendor")
  tariffProducts  LicenseProduct[] @relation("LicenseProductTariff")
  cancelledSubs   Subscription[]   @relation("SubscriptionCancelReason")
  projects        Project[]
  requests        Request[]        @relation("RequestType")
  licenseProducts LicenseProduct[] @relation("LicenseProductCategory")

  @@unique([dictionaryTypeId, code])
  @@index([organizationId])
  @@index([organizationId, systemKey])
}

// ---------------------------------------------------------------------------
// License product catalog ("товарная матрица") + client subscriptions
// ---------------------------------------------------------------------------

enum ProductType {
  LICENSE
  WORK
}

model LicenseProduct {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  type            ProductType      @default(LICENSE)
  categoryValueId String?
  categoryValue   DictionaryValue? @relation("LicenseProductCategory", fields: [categoryValueId], references: [id])

  // Licence portfolio: which vendor's product, which tariff, and the price of
  // one seat when the vendor bills per seat (null = flat price).
  vendorValueId String?
  vendorValue   DictionaryValue? @relation("LicenseProductVendor", fields: [vendorValueId], references: [id])
  tariffValueId String?
  tariffValue   DictionaryValue? @relation("LicenseProductTariff", fields: [tariffValueId], references: [id])
  pricePerSeat  Decimal?         @db.Decimal(14, 2)
  /// Free text shown under the name: what the tariff includes.
  description   String?
  /// Stable key of the row in the built-in vendor catalog this product was
  /// imported from ("wazzup:whatsapp:max:1"), so a re-import updates the
  /// same product instead of creating a duplicate. Null for hand-made ones.
  catalogKey    String?

  // Defaults copied onto a Subscription when it's created from this product;
  // each Subscription can then override them per client deal.
  // defaultDurationMonths is meaningless for a WORK product (a one-off job
  // has no billing cycle to advance) — null there, required for LICENSE.
  defaultPrice              Decimal @db.Decimal(14, 2)
  defaultDurationMonths     Int?    @default(1)
  defaultVendorSharePercent Decimal @default(50) @db.Decimal(5, 2)
  defaultTaxable            Boolean @default(true)

  // Mirror of defaultDurationMonths for a WORK product: an estimated
  // execution time in working days, used to prefill and auto-calculate a
  // Sale's workEndDate ("Дата окончания работ") from the sale date. Null
  // for LICENSE (has no notion of "working days to finish").
  defaultWorkDays Int?

  isActive  Boolean  @default(true)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  subscriptions Subscription[]
  sales         Sale[]

  @@index([organizationId])

  @@unique([organizationId, catalogKey])
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  licenseProductId String
  licenseProduct   LicenseProduct @relation(fields: [licenseProductId], references: [id])

  // Snapshot of terms for this specific client deal — independent of later
  // changes to the product's defaults.
  price              Decimal @db.Decimal(14, 2)
  durationMonths     Int
  vendorSharePercent Decimal @db.Decimal(5, 2)
  taxable            Boolean @default(true)

  status          SubscriptionStatus @default(ACTIVE)
  startDate       DateTime
  nextBillingDate DateTime

  /// When the invoice for the upcoming period was sent to the client — the
  /// preparation stage before "Продлить". A date rather than a flag so the
  /// list can show how long the client has been sitting on it. Cleared by
  /// billSubscription: once the period is billed, the stage is over and the
  /// next cycle starts with no invoice out.
  invoiceSentAt DateTime?

  /// Licence portfolio: seats on this licence and, when the licence period
  /// differs from the billing period, the date it actually expires
  /// (null = same as nextBillingDate). accountRef is the vendor account
  /// (an amoCRM subdomain, a Wazzup workspace) the licence belongs to.
  seats      Int?
  expiresAt  DateTime?
  accountRef String?
  notes      String?

  /// Lifecycle for churn/retention: when the subscription was paused,
  /// resumed and cancelled, and why. Set automatically on status changes,
  /// editable so history can be corrected.
  pausedAt            DateTime?
  cancelledAt         DateTime?
  cancelReasonValueId String?
  cancelReasonValue   DictionaryValue? @relation("SubscriptionCancelReason", fields: [cancelReasonValueId], references: [id])
  cancelComment       String?

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  operations Operation[]

  @@index([organizationId])
  @@index([clientId])
  @@index([nextBillingDate])
  @@index([organizationId, startDate])
}

// A one-off sale of a product to a client — unlike Subscription, this has no
// billing cycle: it books its operations once, on saleDate, and that's it.
// Always carries clientId directly (even though projectId is optional) so
// revenue is never invisible to per-client reporting.
model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  licenseProductId String
  licenseProduct   LicenseProduct @relation(fields: [licenseProductId], references: [id])

  amount   Decimal  @db.Decimal(14, 2)
  saleDate DateTime

  // "Дата окончания работ" — only meaningful when licenseProduct.type is
  // WORK (a one-off job with a deadline instead of a subscription term).
  workEndDate DateTime?

  // Snapshot from the product at the time of sale, for the financial waterfall.
  vendorSharePercent Decimal @db.Decimal(5, 2)
  taxable            Boolean @default(true)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  operations Operation[]

  @@index([organizationId])
  @@index([clientId])
}

// ---------------------------------------------------------------------------
// Operations (income / expense)
// ---------------------------------------------------------------------------

enum OperationType {
  INCOME
  EXPENSE
}

enum OperationStatus {
  PLANNED
  ACTUAL
}

model Operation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  type   OperationType
  status OperationStatus @default(ACTUAL)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("RUB")

  // accrual method date -> used for PnL
  accrualDate DateTime
  // cash method date -> used for DDS (cash flow); null = money not moved yet
  paymentDate DateTime?

  categoryValueId String?
  categoryValue   DictionaryValue? @relation("OperationCategory", fields: [categoryValueId], references: [id])

  paymentMethodValueId String?
  paymentMethodValue   DictionaryValue? @relation("OperationPaymentMethod", fields: [paymentMethodValueId], references: [id])

  /// Which bank account / cash box the money moved through — a value of the
  /// "account" dictionary. Optional so old data and "don't care" both work.
  accountValueId String?
  accountValue   DictionaryValue? @relation("OperationAccount", fields: [accountValueId], references: [id])

  /// An EXPENSE that pays the tax the reserve was set aside for. Cash
  /// position subtracts these from the accrued reserve, so paying tax
  /// doesn't count against "свободные деньги" twice.
  taxPayment Boolean @default(false)
  /// Which obligation a tax payment settles (see taxes.service): usn_advance,
  /// usn_annual, ip_fixed, ip_one_percent — and its period key ("2026-Q1",
  /// "2026", "2025-1pct"). Null on ordinary expenses.
  taxKind   String?
  taxPeriod String?

  counterparty String?
  description  String?
  isDemo       Boolean @default(false)

  // Financial waterfall (see apps/api/src/modules/finance/waterfall.ts):
  // for INCOME, vendorSharePercent is the cut owed to a licensing vendor
  // (0 for services/support), taxable marks whether this money counts
  // toward the accrued tax reserve (false for untaxed "card" payments).
  vendorSharePercent Decimal @default(0) @db.Decimal(5, 2)
  taxable            Boolean @default(true)

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("OperationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([organizationId, accrualDate])
  @@index([organizationId, paymentDate])
  @@index([projectId])
  @@index([subscriptionId])
  @@index([saleId])
  @@index([accountValueId])
}

// ---------------------------------------------------------------------------
// Client requests (tickets) + time tracking
// ---------------------------------------------------------------------------

enum RequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
}

model Request {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      RequestStatus   @default(OPEN)
  priority    RequestPriority @default(MEDIUM)

  requestTypeValueId String?
  requestTypeValue   DictionaryValue? @relation("RequestType", fields: [requestTypeValueId], references: [id])

  isDemo    Boolean   @default(false)
  createdAt DateTime  @default(now())
  closedAt  DateTime?

  timeEntries TimeEntry[]

  @@index([organizationId])
  @@index([projectId])
}

model TimeEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requestId String?
  request   Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  hours       Decimal  @db.Decimal(6, 2)
  description String?
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([projectId])
  @@index([requestId])
}

/// A sales target. `month` null means the annual plan for that year, 1..12 a
/// monthly one — the two are stored side by side and set independently, so a
/// year's monthly plans don't have to add up to its annual plan (and the UI
/// shows the difference when they don't).
///
/// Uniqueness of (organizationId, year, month) is enforced in the service
/// rather than by a unique index: Postgres treats NULLs as distinct, so an
/// index would happily allow two annual plans for the same year.
model SalesPlan {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  year   Int
  month  Int?
  amount Decimal @db.Decimal(14, 2)

  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, year])
}

/// Who changed what: one row per create/update/delete of a business record,
/// with a short human-readable summary. Never deleted with the record —
/// entityId is a plain string, not a relation, precisely so the trail
/// outlives the thing it describes.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String
  entity   String
  entityId String?
  summary  String
  details  Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entity, entityId])
}

/// The organization's tax regime, the numbers the calendar is computed from.
/// One per organization; every rate lives here rather than in code so a new
/// year's figures are a form edit, not a deploy. Amounts in roubles.
model TaxProfile {
  id             String       @id @default(uuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// IP (sole proprietor) or OOO (company).
  form   String @default("IP")
  /// USN_INCOME (6 % of income) or USN_INCOME_EXPENSE (15 % of income − expenses).
  regime String @default("USN_INCOME")
  /// Regional rate, percent.
  ratePercent Decimal @default(6) @db.Decimal(5, 2)
  /// Only for USN_INCOME_EXPENSE: the minimum tax, percent of income.
  minimumTaxPercent Decimal @default(1) @db.Decimal(5, 2)

  /// Fixed contributions a sole proprietor owes for the year, and the
  /// threshold/cap of the extra 1 % over the year's income.
  fixedContributions   Decimal @default(0) @db.Decimal(14, 2)
  onePercentThreshold  Decimal @default(300000) @db.Decimal(14, 2)
  onePercentCap        Decimal @default(0) @db.Decimal(14, 2)
  /// Whether the year's fixed contributions reduce the USN tax as soon as
  /// they are due (the 2025+ rule) rather than only once paid.
  deductFixedWhenDue   Boolean @default(true)
  /// Has employees: caps the contribution deduction at 50 % of the tax.
  hasEmployees Boolean @default(false)

  /// Warn when the year's income approaches this (the VAT threshold for USN).
  vatThreshold Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
